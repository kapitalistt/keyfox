#include <winver.h>

1 24 "keyfox.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "KeyFox"
      VALUE "FileDescription", "KeyFox - console password manager"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "keyfox"
      VALUE "OriginalFilename", "keyfox.exe"
      VALUE "ProductName", "KeyFox"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
